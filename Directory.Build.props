<Project>
  <!--
    Build outputs live outside the source tree (~/xiv-mcp-build by default).
    Set XIVMCP_ARTIFACTS to give a concurrent build its own bin/obj tree.
  -->
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath Condition="'$(XIVMCP_ARTIFACTS)' != ''">$(XIVMCP_ARTIFACTS)</ArtifactsPath>
    <ArtifactsPath Condition="'$(ArtifactsPath)' == ''">$(MSBuildThisFileDirectory)../xiv-mcp-build/artifacts</ArtifactsPath>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    Quality gate (docs/QUALITY-GATE.md). The Roslyn half: the .NET analyzers run on every
    build and every warning is an error, so a reload leak cannot be merged as "just a warning".
    Individual rule severities live in .editorconfig, next to the reason each one is set.
  -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A rule demoted in .editorconfig must stay a warning: promoting every warning to an
         error must not undo those decisions. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors)</WarningsNotAsErrors>
    <!-- CI can take one pass with the gate relaxed to count new noise: -p:QualityGateStrict=false -->
    <TreatWarningsAsErrors Condition="'$(QualityGateStrict)' == 'false'">false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
