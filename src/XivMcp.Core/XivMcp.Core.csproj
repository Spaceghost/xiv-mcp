<Project Sdk="Microsoft.NET.Sdk">
  <!-- Transport + protocol runtime. No Dalamud, no ASP.NET (Dalamud's runtime ships neither). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>XivMcp.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="XivMcp.Core.Tests" />
    <!-- The changelog players read in the What's new tab; CHANGELOG.md is rendered from the same file. -->
    <EmbeddedResource Include="../../changelog.json" LogicalName="XivMcp.Core.changelog.json" />
  </ItemGroup>
</Project>
